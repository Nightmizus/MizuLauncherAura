<Window x:Class="MizuLauncher.LittleSkinLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LittleSkin 登录" Height="350" Width="450"
        Icon="res/icon.png"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        Foreground="White"
        FontFamily="Microsoft YaHei UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="Button" x:Key="BaseButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#E0121212" CornerRadius="12"/>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="LittleSkin 登录" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="X" Style="{StaticResource BaseButtonStyle}" Foreground="White" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnClose_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,10">
                <TextBlock Text="验证服务器 (Yggdrasil API)" Foreground="#80FFFFFF" FontSize="12" Margin="5,0,0,5"/>
                <TextBox x:Name="TxtApiUrl" Text="https://littleskin.cn/api/yggdrasil" Height="40" Padding="10,0" VerticalContentAlignment="Center" Background="#20FFFFFF" Foreground="White" BorderThickness="1" BorderBrush="#30FFFFFF" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="邮箱" Foreground="#80FFFFFF" FontSize="12" Margin="5,0,0,5"/>
                <TextBox x:Name="TxtEmail" Height="40" Padding="10,0" VerticalContentAlignment="Center" Background="#20FFFFFF" Foreground="White" BorderThickness="1" BorderBrush="#30FFFFFF" FontSize="14" Margin="0,0,0,15"/>
                
                <TextBlock Text="密码" Foreground="#80FFFFFF" FontSize="12" Margin="5,0,0,5"/>
                <PasswordBox x:Name="TxtPassword" Height="40" Padding="10,0" VerticalContentAlignment="Center" Background="#20FFFFFF" Foreground="White" BorderThickness="1" BorderBrush="#30FFFFFF" FontSize="14" Margin="0,0,0,20"/>
                
                <TextBlock x:Name="TxtStatus" Text="" Foreground="#FF8B8B" FontSize="12" Margin="5,0,0,5" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="80" Height="32" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0" Click="BtnClose_Click"/>
                <Button x:Name="BtnLogin" Content="登录" Width="80" Height="32" Style="{StaticResource PrimaryButtonStyle}" Click="BtnLogin_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>